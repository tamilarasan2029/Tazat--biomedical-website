# Copy this file to .env and fill in the values. Never commit .env to git.

# SMTP server used to send enquiry notifications (Gmail example shown)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password

# Sender shown on the email, and the administrator who receives enquiries
ENQUIRY_FROM=your-address@gmail.com
ENQUIRY_TO=admin-address@example.com
